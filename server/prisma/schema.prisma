generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ======================================================
// MEMBER
// ======================================================

model Member {
  memberId            BigInt       @id @default(autoincrement())
  memberCode          String       @unique @db.VarChar(8)
  recieptNo           String?      @db.VarChar(8)

  joinDate            DateTime?    @db.Date

  name                String       @db.VarChar(50)
  nameKannada         String?      @db.VarChar(50)

  careOfName          String?      @db.VarChar(50)
  careOfNameKannada   String?      @db.VarChar(50)

  mobile              String?      @db.VarChar(10)

  memberType          MemberType   @default(MEMBER)
  status              MemberStatus @default(ACTIVE)
  gender              Gender?

  // Current address
  addressLine1        String?      @db.VarChar(255)
  addressLine2        String?      @db.VarChar(255)
  city                String?      @db.VarChar(50)
  district            String?      @db.VarChar(50)

  addressLine1Kannada String?      @db.VarChar(255)
  addressLine2Kannada String?      @db.VarChar(255)
  cityKannada         String?      @db.VarChar(50)
  districtKannada     String?      @db.VarChar(50)

  postalCode          String?      @db.VarChar(6)

  // Family
  fatherName          String?      @db.VarChar(50)
  fatherNameKannada   String?      @db.VarChar(50)
  spouseName          String?      @db.VarChar(50)
  spouseNameKannada   String?      @db.VarChar(50)

  dob                 DateTime?    @db.Date

  alternateMobile     String?      @db.VarChar(10)
  email               String?      @db.VarChar(100)

  // Identification
  aadhaarNumber       String?      @db.VarChar(16)
  panNumber           String?      @db.VarChar(11)
  otherId             String?      @db.VarChar(20)

  // Nominee
  nomineeName         String?      @db.VarChar(50)
  nomineeRelation     String?      @db.VarChar(15)
  nomineeMobile       String?      @db.VarChar(10)
  nomineeEmail        String?      @db.VarChar(50)
  nomineeAddress      String?      @db.VarChar(200)
  nomineeDateOfBirth  DateTime?    @db.Date

  // Login
  passwordHash        String?      @db.VarChar(255)

  occupation          String?      @db.VarChar(150)
  permanentAddress    String?      @db.VarChar(200)
  officeAddress       String?      @db.VarChar(200)
  remarks             String?      @db.VarChar(200)

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt


//simply mapping

directorships    Director[]
gbmLetterReturns GbmLetterReturn[]
addressHistory MemberAddressHistory[]
  // Transaction relations
  transactions        Transaction[] @relation("TransactionMember")
  createdTransactions Transaction[] @relation("TransactionCreatedBy")
  updatedTransactions Transaction[] @relation("TransactionUpdatedBy")
  allottedSites       Site[]

  @@index([name])
  @@index([nameKannada])
  @@index([mobile])
  @@index([city])
  @@index([cityKannada])
  @@index([district])
  @@index([districtKannada])
  @@index([memberType])
  @@index([status])
  @@index([panNumber])
  @@index([aadhaarNumber])

  @@map("members")
}


enum MemberType {
  SUPERUSER
  MEMBER
  ASSOCIATE
}


enum MemberStatus {
  ACTIVE
  INACTIVE
  INCORRECT
  RESIGNED
  DECEASED
}


enum Gender {
  MALE
  FEMALE
  OTHER
}


// ======================================================
// PARTY
// ======================================================

model Party {
  id        BigInt   @id @default(autoincrement())

  name      String
  partyType String
  status    String   @default("active")

  mobile    String?
  address   String?
  details   String?

  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions    Transaction[]     @relation("TransactionParty")
  cancelledCheques CancelledCheque[]
  chequeRanges     ChequeRange[]
  @@unique([name, partyType])
  @@index([partyType])
  @@index([status])
  @@index([startDate, endDate])

  @@map("parties")
}


// ======================================================
// LAYOUT
// ======================================================

model Layout {
  id            BigInt   @id @default(autoincrement())

  layoutCode    String   @unique
  name          String
  location      String?
  address       String?
  surveyNumbers String?

  // Party IDs of developers
  developerIds  BigInt[]

  description   String?
  otherDetails  String?

  status        String   @default("active")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Layout prices
  prices LayoutPrice[]

  // Transaction relations
  transactions Transaction[] @relation("TransactionLayout")
  sites        Site[]

  @@index([status])

  @@map("layouts")
}


// ======================================================
// LAYOUT PRICE
// ======================================================

model LayoutPrice {
  id           BigInt  @id @default(autoincrement())

  layoutId     BigInt

  pricePerSqFt Decimal @db.Decimal(12, 2)

  validFrom    DateTime  @db.Date
  validTo      DateTime? @db.Date

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  layout       Layout @relation(fields: [layoutId], references: [id])

  @@index([layoutId, validFrom, validTo])

  @@map("layout_prices")
}

// ======================================================
// TRANSACTION ENUMS
// ======================================================

enum PaymentMode {
  CASH
  CHEQUE
  BANK_TRANSFER
  UPI
  OTHER
}


enum TransactionType {
  CREDIT
  DEBIT
}

model Transaction {
  id              BigInt   @id @default(autoincrement())
  transactionNo   String   @unique
  transactionDate DateTime @db.Date
  cashbookNo      Int?
  cashbookPage    Int?

  type            TransactionType
  subType         String

  memberId        BigInt?
  partyId         BigInt?
  layoutId        BigInt?

  shareAmount           Decimal @default(0) @db.Decimal(15, 2)
  shareFeeAmount        Decimal @default(0) @db.Decimal(15, 2)
  membershipFeeAmount   Decimal @default(0) @db.Decimal(15, 2)
  siteDepositAmount     Decimal @default(0) @db.Decimal(15, 2)
  welfareFundAmount     Decimal @default(0) @db.Decimal(15, 2)
  booksFormsAmount      Decimal @default(0) @db.Decimal(15, 2)
  miscellaneousAmount   Decimal @default(0) @db.Decimal(15, 2)
  otherAmount           Decimal @default(0) @db.Decimal(15, 2)

  totalAmount           Decimal @db.Decimal(15, 2)

  receiptNo             String?
  paymentMode           PaymentMode?
  chequeNo              String?
  chequeDate            DateTime? @db.Date
  bankReferenceNo       String?

  remarks               String?

  createdBy             BigInt?
  createdAt             DateTime  @default(now())
  updatedBy             BigInt?
  updatedAt             DateTime  @updatedAt

  member Member? @relation("TransactionMember", fields: [memberId], references: [memberId])
  party  Party?  @relation("TransactionParty", fields: [partyId], references: [id])
  layout Layout? @relation("TransactionLayout", fields: [layoutId], references: [id])

  createdByMember Member? @relation("TransactionCreatedBy", fields: [createdBy], references: [memberId])
  updatedByMember Member? @relation("TransactionUpdatedBy", fields: [updatedBy], references: [memberId])

  @@index([memberId, transactionDate, id])
  @@index([partyId, transactionDate])
  @@index([layoutId, transactionDate])
  @@index([type, transactionDate])
  @@index([subType, transactionDate])

  @@map("transactions")
}

model CancelledCheque {
  id            BigInt   @id @default(autoincrement())
  partyId       BigInt
  chequeNo      String
  cancelledDate DateTime @db.Date
  reason        String?
  remarks       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  party Party @relation(fields: [partyId], references: [id])

  @@unique([partyId, chequeNo])
  @@index([chequeNo])
  @@index([cancelledDate])
  @@map("cancelled_cheques")
}
model CancelledReceipt {
  id            BigInt   @id @default(autoincrement())

  receiptNo     String
  cancelledDate DateTime @db.Date
  reason        String?
  remarks       String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([receiptNo])
  @@index([cancelledDate])
  @@map("cancelled_receipts")
}
model Director {
  id        BigInt   @id @default(autoincrement())

  memberId  BigInt
  position  String
  quota     String
  term      Int
  fromDate  DateTime @db.Date
  toDate    DateTime? @db.Date
  remarks   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [memberId])

  @@index([memberId])
  @@index([fromDate, toDate])
  @@map("directors")
}
model GbmLetterReturn {
  id            BigInt   @id @default(autoincrement())

  memberId      BigInt
  gbmDate       DateTime @db.Date
  letterDate    DateTime? @db.Date
  returnDate    DateTime @db.Date
  returnReason  String?
  remarks       String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [memberId])

  @@index([memberId, gbmDate])
  @@index([returnDate])
  @@map("gbm_letter_returns")
}

model ChequeRange {
  id            BigInt   @id @default(autoincrement())
  partyId       BigInt
  startChequeNo String
  endChequeNo   String
  receivedDate  DateTime @db.Date
  remarks       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  party Party @relation(fields: [partyId], references: [id])

  @@index([partyId])
  @@index([startChequeNo, endChequeNo])
  @@index([receivedDate])
  @@map("cheque_ranges")
}

model MemberAddressHistory {
  id           BigInt   @id @default(autoincrement())

  memberId     BigInt

  addressLine1 String?
  addressLine2 String?
  city         String?
  district     String?
  addressLine1Kannada String?
  addressLine2Kannada String?
  cityKannada  String?
  districtKannada String?
  postalCode   String?

  fromDate     DateTime @db.Date
  toDate       DateTime? @db.Date

  createdAt    DateTime @default(now())

  member Member @relation(fields: [memberId], references: [memberId])

  @@index([memberId, fromDate])
  @@index([memberId, toDate])
  @@index([city])
  @@map("member_address_history")
}

model Site {
  id                BigInt    @id @default(autoincrement())
  layoutId          BigInt
  siteNo            String
  eastWest          Decimal   @db.Decimal(12, 2)
  northSouth        Decimal   @db.Decimal(12, 2)
  totalSqFeet       Decimal   @db.Decimal(12, 2)
  totalPrice        Decimal   @default(0) @db.Decimal(15, 2)
  registeredAmount  Decimal   @default(0) @db.Decimal(15, 2)
  allottedMemberId  BigInt?
  allotmentDate     DateTime? @db.Date
  status            String    @default("AVAILABLE")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  layout         Layout  @relation(fields: [layoutId], references: [id])
  allottedMember Member? @relation(fields: [allottedMemberId], references: [memberId])

  @@unique([layoutId, siteNo])
  @@index([layoutId])
  @@index([allottedMemberId])
  @@index([status])
  @@map("sites")
}