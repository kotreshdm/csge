generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ======================================================
// MEMBER
// ======================================================

model Member {
  memberId            BigInt       @id @default(autoincrement())
  memberCode          String       @unique @db.VarChar(8)
  recieptNo           String?      @db.VarChar(8)

  joinDate            DateTime?    @db.Date

  name                String       @db.VarChar(50)
  nameKannada         String?      @db.VarChar(50)

  careOfName          String?      @db.VarChar(50)
  careOfNameKannada   String?      @db.VarChar(50)

  mobile              String?      @db.VarChar(10)

  memberType          MemberType   @default(MEMBER)
  status              MemberStatus @default(ACTIVE)
  gender              Gender?

  // Current address
  addressLine1        String?      @db.VarChar(255)
  addressLine2        String?      @db.VarChar(255)
  city                String?      @db.VarChar(50)
  district            String?      @db.VarChar(50)

  addressLine1Kannada String?      @db.VarChar(255)
  addressLine2Kannada String?      @db.VarChar(255)
  cityKannada         String?      @db.VarChar(50)
  districtKannada     String?      @db.VarChar(50)

  postalCode          String?      @db.VarChar(6)

  // Family
  fatherName          String?      @db.VarChar(50)
  fatherNameKannada   String?      @db.VarChar(50)
  spouseName          String?      @db.VarChar(50)
  spouseNameKannada   String?      @db.VarChar(50)

  dob                 DateTime?    @db.Date

  alternateMobile     String?      @db.VarChar(10)
  email               String?      @db.VarChar(100)

  // Identification
  aadhaarNumber       String?      @db.VarChar(16)
  panNumber           String?      @db.VarChar(11)
  otherId             String?      @db.VarChar(20)

  // Nominee
  nomineeName         String?      @db.VarChar(50)
  nomineeRelation     String?      @db.VarChar(15)
  nomineeMobile       String?      @db.VarChar(10)
  nomineeEmail        String?      @db.VarChar(50)
  nomineeAddress      String?      @db.VarChar(200)
  nomineeDateOfBirth  DateTime?    @db.Date

  // Login
  passwordHash        String?      @db.VarChar(255)

  occupation          String?      @db.VarChar(150)
  permanentAddress    String?      @db.VarChar(200)
  officeAddress       String?      @db.VarChar(200)
  remarks             String?      @db.VarChar(200)

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt


//simply mapping

directorships    Director[]
gbmLetterReturns GbmLetterReturn[]
addressHistory MemberAddressHistory[]
  // Transaction relations
  transactions        Transaction[] @relation("TransactionMember")
  createdTransactions Transaction[] @relation("TransactionCreatedBy")
  updatedTransactions Transaction[] @relation("TransactionUpdatedBy")

  @@index([name])
  @@index([nameKannada])
  @@index([mobile])
  @@index([city])
  @@index([cityKannada])
  @@index([district])
  @@index([districtKannada])
  @@index([memberType])
  @@index([status])
  @@index([panNumber])
  @@index([aadhaarNumber])

  @@map("members")
}


enum MemberType {
  SUPERUSER
  MEMBER
  ASSOCIATE
}


enum MemberStatus {
  ACTIVE
  INACTIVE
  INCORRECT
  RESIGNED
  DECEASED
}


enum Gender {
  MALE
  FEMALE
  OTHER
}


// ======================================================
// PARTY
// ======================================================

model Party {
  id        BigInt   @id @default(autoincrement())

  name      String
  partyType String
  status    String   @default("active")

  mobile    String?
  address   String?
  details   String?

  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Transaction relation
  transactions Transaction[] @relation("TransactionParty")

  @@unique([name, partyType])
  @@index([partyType])
  @@index([status])
  @@index([startDate, endDate])

  @@map("parties")
}


// ======================================================
// LAYOUT
// ======================================================

model Layout {
  id            BigInt   @id @default(autoincrement())

  layoutCode    String   @unique
  name          String
  location      String?
  address       String?
  surveyNumbers String?

  // Party IDs of developers
  developerIds  BigInt[]

  description   String?
  otherDetails  String?

  status        String   @default("active")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Layout prices
  prices LayoutPrice[]

  // Transaction relations
  transactions      Transaction[] @relation("TransactionLayout")
  transactionsFrom  Transaction[] @relation("TransactionFromLayout")
  transactionsTo    Transaction[] @relation("TransactionToLayout")

  @@index([status])

  @@map("layouts")
}


// ======================================================
// LAYOUT PRICE
// ======================================================

model LayoutPrice {
  id           BigInt  @id @default(autoincrement())

  layoutId     BigInt

  pricePerSqFt Decimal @db.Decimal(12, 2)

  validFrom    DateTime  @db.Date
  validTo      DateTime? @db.Date

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  layout       Layout @relation(fields: [layoutId], references: [id])

  @@index([layoutId, validFrom, validTo])

  @@map("layout_prices")
}


// ======================================================
// ACCOUNT
// ======================================================

model Account {
  id             BigInt   @id @default(autoincrement())

  accountCode    String   @unique
  name           String
  accountType    String

  accountNumber  String?
  bankName       String?

  openingBalance Decimal  @default(0) @db.Decimal(15, 2)

  isActive       Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Transaction relations
  cancelledCheques CancelledCheque[]
  chequeRanges     ChequeRange[]
  transactionsFrom Transaction[] @relation("TransactionFromAccount")
  transactionsTo   Transaction[] @relation("TransactionToAccount")

  @@index([accountType])
  @@index([isActive])

  @@map("accounts")
}


// ======================================================
// TRANSACTION ENUMS
// ======================================================

enum TransactionDirection {
  IN
  OUT
  TRANSFER
}


enum TransactionType {
  SHARE
  LAYOUT
  BANK
  EXPENSE
  INCOME
  ADVANCE
  ASSET
  OTHER
}


enum PaymentMode {
  CASH
  CHEQUE
  BANK_TRANSFER
  UPI
  OTHER
}


// ======================================================
// TRANSACTION
// ======================================================

model Transaction {
 id              BigInt   @id @default(autoincrement())
  transactionDate DateTime @db.Date

  direction       TransactionDirection
  type            TransactionType
  subType         String

  // --------------------------------------------------
  // Cashbook reference
  // --------------------------------------------------

  cashbookNo      Int?
  cashbookPage    Int?

  // --------------------------------------------------
  // Member / Party
  // --------------------------------------------------

  memberId        BigInt?
  partyId         BigInt?

  // --------------------------------------------------
  // Layout
  // --------------------------------------------------

  layoutId        BigInt?
  fromLayoutId    BigInt?
  toLayoutId      BigInt?

  // --------------------------------------------------
  // Amounts
  // --------------------------------------------------

  shareAmount           Decimal @default(0) @db.Decimal(10, 2)
  shareFeeAmount        Decimal @default(0) @db.Decimal(10, 2)
  membershipFeeAmount   Decimal @default(0) @db.Decimal(10, 2)
  siteDepositAmount     Decimal @default(0) @db.Decimal(10, 2)
  welfareFundAmount     Decimal @default(0) @db.Decimal(10, 2)
  booksFormsAmount      Decimal @default(0) @db.Decimal(10, 2)
  miscellaneousAmount   Decimal @default(0) @db.Decimal(10, 2)
  otherAmount           Decimal @default(0) @db.Decimal(10, 2)

  totalAmount           Decimal @default(0) @db.Decimal(15, 2)

  // --------------------------------------------------
  // Account movement
  // --------------------------------------------------

  fromAccountId         BigInt?
  toAccountId           BigInt?

  // --------------------------------------------------
  // Receipt / Payment
  // --------------------------------------------------

  receiptNo             String?
  paymentMode           PaymentMode?

  chequeNo              String?
  chequeDate            DateTime? @db.Date

  bankReferenceNo       String?

  // --------------------------------------------------
  // Related transaction
  // --------------------------------------------------

  referenceTransactionId BigInt?

  // --------------------------------------------------
  // Description
  // --------------------------------------------------

  description           String?
  remarks               String?

  // --------------------------------------------------
  // Audit
  // --------------------------------------------------

  createdBy             BigInt
  createdAt             DateTime @default(now())

  updatedBy             BigInt?
  updatedAt             DateTime @updatedAt

  // ==================================================
  // RELATIONS
  // ==================================================

  member Member? @relation("TransactionMember", fields: [memberId], references: [memberId])

  party Party? @relation("TransactionParty", fields: [partyId], references: [id])

  layout Layout? @relation("TransactionLayout", fields: [layoutId], references: [id])

  fromLayout Layout? @relation("TransactionFromLayout", fields: [fromLayoutId], references: [id])

  toLayout Layout? @relation("TransactionToLayout", fields: [toLayoutId], references: [id])

  fromAccount Account? @relation("TransactionFromAccount", fields: [fromAccountId], references: [id])

  toAccount Account? @relation("TransactionToAccount", fields: [toAccountId], references: [id])

  // Self reference
  referenceTransaction Transaction? @relation("TransactionReference", fields: [referenceTransactionId], references: [id])

  referencedTransactions Transaction[] @relation("TransactionReference")

  // Created / updated by member
  creator Member @relation("TransactionCreatedBy", fields: [createdBy], references: [memberId])

  updater Member? @relation("TransactionUpdatedBy", fields: [updatedBy], references: [memberId])

  // ==================================================
  // INDEXES
  // ==================================================

  @@index([memberId, transactionDate])
  @@index([partyId, transactionDate])
  @@index([layoutId, transactionDate])

  @@index([type, subType, transactionDate])

  @@index([fromAccountId, transactionDate])
  @@index([toAccountId, transactionDate])

  @@index([receiptNo])
  @@index([chequeNo])
  @@index([bankReferenceNo])

  @@index([referenceTransactionId])

  @@index([transactionDate])
}

model CancelledCheque {
  id            BigInt   @id @default(autoincrement())

  accountId     BigInt
  chequeNo      String
  cancelledDate DateTime @db.Date
  reason        String?
  remarks       String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id])

  @@unique([accountId, chequeNo])
  @@index([chequeNo])
  @@index([cancelledDate])
  @@map("cancelled_cheques")
}
model CancelledReceipt {
  id            BigInt   @id @default(autoincrement())

  receiptNo     String
  cancelledDate DateTime @db.Date
  reason        String?
  remarks       String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([receiptNo])
  @@index([cancelledDate])
  @@map("cancelled_receipts")
}
model Director {
  id        BigInt   @id @default(autoincrement())

  memberId  BigInt
  position  String
  quota     String
  term      Int
  fromDate  DateTime @db.Date
  toDate    DateTime? @db.Date
  remarks   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [memberId])

  @@index([memberId])
  @@index([fromDate, toDate])
  @@map("directors")
}
model GbmLetterReturn {
  id            BigInt   @id @default(autoincrement())

  memberId      BigInt
  gbmDate       DateTime @db.Date
  letterDate    DateTime? @db.Date
  returnDate    DateTime @db.Date
  returnReason  String?
  remarks       String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [memberId])

  @@index([memberId, gbmDate])
  @@index([returnDate])
  @@map("gbm_letter_returns")
}

model ChequeRange {
  id            BigInt   @id @default(autoincrement())

  accountId     BigInt
  startChequeNo String
  endChequeNo   String
  receivedDate  DateTime @db.Date
  remarks       String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([startChequeNo, endChequeNo])
  @@index([receivedDate])
  @@map("cheque_ranges")
}

model MemberAddressHistory {
  id           BigInt   @id @default(autoincrement())

  memberId     BigInt

  addressLine1 String?
  addressLine2 String?
  city         String?
  district     String?
  addressLine1Kannada String?
  addressLine2Kannada String?
  cityKannada  String?
  districtKannada String?
  postalCode   String?

  fromDate     DateTime @db.Date
  toDate       DateTime? @db.Date

  createdAt    DateTime @default(now())

  member Member @relation(fields: [memberId], references: [memberId])

  @@index([memberId, fromDate])
  @@index([memberId, toDate])
  @@index([city])
  @@map("member_address_history")
}